{
    "name": "sahiljb/lara-auto-backup",
    "description": "Automated MySQL/PostgreSQL database backups for Laravel, uploaded to AWS S3 or Cloudflare R2.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "backup", "database", "s3", "r2", "cloudflare"],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^9.0|^10.0|^11.0",
        "illuminate/console": "^9.0|^10.0|^11.0",
        "symfony/process": "^6.0|^7.0",
        "league/flysystem-aws-s3-v3": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "SahilJB\\LaraAutoBackup\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "SahilJB\\LaraAutoBackup\\BackupServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable"
}
