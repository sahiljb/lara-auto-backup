{
    "name": "sahiljb/lara-auto-backup",
    "description": "Automated database backups for Laravel — dump MySQL, MariaDB, PostgreSQL or SQLite on a schedule and upload to AWS S3 or Cloudflare R2.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "backup",
        "database",
        "mysql",
        "postgresql",
        "s3",
        "r2",
        "cloudflare",
        "scheduled-backup"
    ],
    "homepage": "https://github.com/sahiljb/lara-auto-backup",
    "support": {
        "issues": "https://github.com/sahiljb/lara-auto-backup/issues",
        "source": "https://github.com/sahiljb/lara-auto-backup"
    },
    "authors": [
        {
            "name": "Sahil JB",
            "email": "sjbuddhadev@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/console": "^10.0|^11.0|^12.0",
        "illuminate/contracts": "^10.0|^11.0|^12.0",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "symfony/process": "^6.0|^7.0"
    },
    "require-dev": {
        "league/flysystem-aws-s3-v3": "^3.0",
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.5|^11.0"
    },
    "suggest": {
        "league/flysystem-aws-s3-v3": "Required to upload backups to AWS S3 or Cloudflare R2 (^3.0)."
    },
    "autoload": {
        "psr-4": {
            "SahilJB\\LaraAutoBackup\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SahilJB\\LaraAutoBackup\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "SahilJB\\LaraAutoBackup\\BackupServiceProvider"
            ],
            "aliases": {
                "Backup": "SahilJB\\LaraAutoBackup\\Facades\\Backup"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
